{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "User Service",
            "request": "launch",
            "mainClass": "com.Proyect.UserService.UserServiceApp",
            "projectName": "cursoSpring",
            "cwd":"${workspaceFolder}/User_Services",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "Gateway Service",
            "request": "launch",
            "mainClass": "com.gateway.Gateway_Service.GatewayServiceApplication",
            "projectName": "Gateway_Service",
            "cwd":"${workspaceFolder}/Gateway_Service",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "Payments Service",
            "request": "launch",
            "mainClass": "com.Paymentshub.Payments_Services.PaymentsServicesApplication",
            "projectName": "Payments_Services",
            "cwd":"${workspaceFolder}/Payments_Services",
            "envFile": "${workspaceFolder}/.env"
        }
    ],
    "compounds": [
        {
            "name": "Todos los servicios",
            "configurations": [
                "User Service",
                "Payments Service",
                "Gateway Service"
            ]
        }
    ]
}